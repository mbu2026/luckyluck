// Helper function to calculate distance sum for a set of numbers
function calculateDistanceSum(numbers) {
    if (numbers.length < 2) return 0;
    let sum = 0;
    for (let i = 0; i < numbers.length - 1; i++) {
        sum += Math.abs(numbers[i] - numbers[i + 1]);
